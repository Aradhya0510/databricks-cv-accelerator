# Sourced by the AI Runtime command scripts in this directory.
#
# An ai_runtime_task cannot pass arguments to its command, so the config to run
# is chosen here.  `databricks air run` can override it per submission through
# env_variables (see air/*.yaml).  The bundle's deploy and monitoring tasks take
# the same path through the `config_path` variable in databricks.yml; keep the
# two in step.

CV_CONFIG_PATH="${CV_CONFIG_PATH:-configs/detection_detr_config.yaml}"
